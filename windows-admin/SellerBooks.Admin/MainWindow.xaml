<Window x:Class="SellerBooks.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SellerBooks Admin"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">
    <Grid>
        <wv2:WebView2 x:Name="Browser"
                      Visibility="Visible"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <Grid x:Name="OfflinePanel"
              Visibility="Collapsed"
              Background="#F1F5F9">
            <Border Width="520"
                    Padding="36"
                    Background="White"
                    CornerRadius="20"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Tidak Ada Internet"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Koneksi internet terputus. Periksa koneksi internet Anda kemudian coba lagi."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="15"
                               Foreground="#64748B"
                               Margin="0,0,0,24"/>
                    <Button Content="Coba Lagi"
                            Width="150"
                            Height="46"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Click="RetryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
